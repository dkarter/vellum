---
import "../styles/site.css";
import logo from "../assets/logo.png";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const docs = `${base}/docs/`;
const install = `${base}/docs/installation/`;
const canonical = new URL(`${base}/`, Astro.site);
const socialImage = new URL(`${base}/og-image.png`, Astro.site);
const useCases = [
  ["01", "Command palette", "Turn structured data into a searchable layer over the tools you already use."],
  ["02", "Session switcher", "See live multiplexer state, then focus a workspace without leaving the keyboard."],
  ["03", "Agent selection", "Scan rich status, task, and repository context before choosing the right agent."],
  ["04", "File finding", "Search paths with fd, frecency ranking, file icons, and clean stdout composition."],
];
const themes = [
  { name: "Tokyo Night", bg: "#1a1b26", fg: "#c0caf5", muted: "#565f89", select: "#7aa2f7", mode: "#9ece6a" },
  { name: "Catppuccin Mocha", bg: "#1e1e2e", fg: "#cdd6f4", muted: "#585b70", select: "#89b4fa", mode: "#a6e3a1" },
  { name: "Gruvbox Dark", bg: "#282828", fg: "#ebdbb2", muted: "#665c54", select: "#d79921", mode: "#b8bb26" },
  { name: "Nord", bg: "#2e3440", fg: "#d8dee9", muted: "#4c566a", select: "#88c0d0", mode: "#a3be8c" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Vellum is a fast, customizable terminal command palette built in Rust for sessions, agents, files, and live workflows." />
    <meta name="theme-color" content="#17140f" />
    <meta property="og:title" content="Vellum: The fast menu for your terminal." />
    <meta property="og:description" content="A fast, customizable terminal command palette built in Rust for sessions, agents, files, and live workflows." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Vellum workspace palette with live status and native actions" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Vellum workspace palette with live status and native actions" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}/favicon.png`} />
    <title>Vellum: The fast menu for your terminal.</title>
    <script is:inline>
      const theme = localStorage.getItem("starlight-theme");
      if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
    </script>
  </head>
  <body>
    <header class="masthead shell">
      <a class="wordmark" href={`${base}/`} aria-label="Vellum home"><img src={logo.src} alt="" /><strong>Vellum</strong></a>
      <nav aria-label="Main navigation">
        <a href={docs}>Documentation</a>
        <a href="https://github.com/dkarter/vellum">GitHub</a>
        <button type="button" class="theme-toggle" aria-label="Switch to dark theme" aria-pressed="false" title="Switch to dark theme">◐</button>
      </nav>
    </header>

    <main>
      <section class="hero shell">
        <div class="hero-copy">
          <p class="kicker">A terminal menu for live workflows</p>
          <h1>The fast menu<br /><em>for your terminal.</em></h1>
          <p class="lede">Vellum is a fast, customizable terminal command palette built in Rust. Turn commands, files, and built-in integrations into fuzzy palettes with rich items, exact filters, live refresh, and safe native actions.</p>
          <div class="hero-actions">
            <a class="primary" href={install}>Install Vellum <span>↗</span></a>
            <a href={docs}>Read the docs</a>
          </div>
        </div>

        <div class="demo-wrap" data-vellum-demo data-step="0">
          <div class="demo-label"><span>HERDR / WORKSPACES</span><span data-demo-stage>ready</span></div>
          <div class="terminal" role="img" aria-label="Animated Vellum workspace palette demonstrating fuzzy search, multiline results, live status updates, and native actions">
            <div class="palette-title"><span>Jump to Workspace</span></div>
            <fieldset class="palette-search">
              <legend>Workspaces</legend>
              <div class="search-box"><span class="placeholder">Switch workspace...</span><span class="query" aria-hidden="true"><i>d</i><i>o</i><i>c</i><i>s</i></span><span class="cursor"></span></div>
            </fieldset>
            <div class="items" aria-hidden="true">
              <div class="item item-dotfiles selected">
                <div class="item-copy"><b>dotfiles</b><small><span class="folder">■</span> ~/dotfiles</small></div>
                <div class="item-meta"><span class="state idle"><i></i> idle</span><small>▣ OpenCode</small></div>
              </div>
              <div class="item item-foreman">
                <div class="item-copy"><b>foreman</b><small><span class="folder">■</span> ~/dev/foreman</small></div>
                <div class="item-meta"><span class="state unknown">· unknown</span></div>
              </div>
              <div class="item item-lnr">
                <div class="item-copy"><b>lnr</b><small><span class="folder">■</span> ~/dev/lnr</small></div>
                <div class="item-meta"><span class="state idle"><i></i> idle</span><small>▣ OpenCode</small></div>
              </div>
              <div class="item item-vellum">
                <div class="item-copy"><b>vellum</b><small><span class="folder">■</span> ~/dev/vellum</small></div>
                <div class="item-meta"><span class="state idle"><i></i> idle</span><small>▣ OpenCode</small></div>
              </div>
              <div class="item item-docs">
                <div class="item-copy"><b><mark>docs</mark><span>-website</span></b><small><span class="folder">■</span> ~/.herdr/worktrees/vellum/docs-website</small></div>
                <div class="item-meta"><span class="state state-docs"><i></i><span class="before">idle</span><span class="after">working</span></span><small>▣ OpenCode</small></div>
              </div>
            </div>
            <fieldset class="action-menu" aria-hidden="true">
              <legend>Actions</legend>
              <div class="action-search"><span>›</span> Filter actions...</div>
              <div class="action selected"><span>⌕</span><div><b>Focus workspace</b><small>Switch to the selected Herdr workspace</small></div></div>
              <div class="action"><span>×</span><div><b>Close workspace</b><small>Close the selected Herdr workspace</small></div></div>
              <div class="action"><span>◉</span><div><b>Open repository</b><small>Open this checkout's repository on GitHub</small></div></div>
            </fieldset>
            <div class="terminal-foot"><span>INSERT</span><span class="result-count"><span class="before">5/5</span><span class="after">1/5</span></span><span class="foot-copy">up/down navigate&nbsp;&nbsp; enter select&nbsp;&nbsp; esc cancel&nbsp;&nbsp; ctrl-g status&nbsp;&nbsp; ctrl-a actions</span></div>
          </div>
          <div class="demo-controls">
            <p class="sr-only" aria-live="polite" data-demo-live>Vellum palette ready.</p>
            <button type="button" data-demo-replay>Replay demo <span>↻</span></button>
            <ol aria-label="Demo sequence">
              <li data-dot="1">search</li><li data-dot="2">select</li><li data-dot="3">refresh</li><li data-dot="4">actions</li>
            </ol>
          </div>
        </div>
      </section>

      <section class="statement shell" aria-labelledby="statement-title">
        <div class="statement-copy">
          <p class="kicker">A thin layer, not a new world</p>
          <h2 id="statement-title">Pipe data in.<br /><em>Pick what matters.</em></h2>
          <p>Keep the commands and scripts you trust. Vellum turns their structured output into a searchable, live interface without taking over your workflow.</p>
        </div>
        <div class="transform-demo" role="img" aria-label="A shell command emitting structured workspace data that Vellum turns into a searchable menu">
          <div class="raw-output">
            <div class="visual-label"><span>01</span> COMMAND OUTPUT</div>
            <div class="command-line"><span>$</span> herdr api snapshot</div>
            <pre><code><span>[</span>
  &#123;
    <b>"label"</b>: <i>"dotfiles"</i>,
    <b>"path"</b>: <i>"~/dotfiles"</i>,
    <b>"status"</b>: <i>"idle"</i>,
    <b>"agent"</b>: <i>"OpenCode"</i>
  &#125;,
  &#123;
    <b>"label"</b>: <i>"vellum"</i>,
    <b>"path"</b>: <i>"~/dev/vellum"</i>,
    <b>"status"</b>: <i>"working"</i>,
    <b>"agent"</b>: <i>"OpenCode"</i>
  &#125;
<span>]</span></code></pre>
          </div>
          <div class="transform-arrow"><span>JSON</span><i>→</i></div>
          <div class="menu-output">
            <div class="visual-label"><span>02</span> VELLUM</div>
            <div class="mini-menu">
              <fieldset><legend>Workspaces</legend><span>vel</span><i></i></fieldset>
              <div class="mini-result"><div><b>vellum</b><small>~/dev/vellum</small></div><div><span>● working</span><small>OpenCode</small></div></div>
              <footer><b>INSERT</b><span>1/2</span><span>enter select</span></footer>
            </div>
          </div>
        </div>
      </section>

      <section class="use-cases shell" aria-labelledby="use-cases-title">
        <div class="section-intro">
          <p class="kicker">Four shapes, one vocabulary</p>
          <h2 id="use-cases-title">Compose it<br />around your work.</h2>
        </div>
        <div class="case-grid">
          {useCases.map(([number, title, body]) => <article><span>{number}</span><h3>{title}</h3><p>{body}</p></article>)}
        </div>
      </section>

      <section class="themes shell" aria-labelledby="themes-title">
        <div class="theme-copy">
          <p class="kicker">Your terminal, your colors</p>
          <h2 id="themes-title">Looks at home.<br /><em>In every setup.</em></h2>
          <p>Set eight colors in TOML to match the rest of your terminal. Use named terminal colors or exact hex values, globally or per palette.</p>
          <a href={`${base}/docs/configuration/#theme-example`}>Configure your theme →</a>
          <a class="theme-examples-link" href="https://github.com/dkarter/vellum/tree/main/examples/themes">Browse theme files →</a>
        </div>
        <div class="theme-grid" aria-label="Vellum theme examples">
          {themes.map((theme) => (
            <article class="theme-card" style={`--preview-bg:${theme.bg};--preview-fg:${theme.fg};--preview-muted:${theme.muted};--preview-select:${theme.select};--preview-mode:${theme.mode}`}>
              <div class="theme-preview">
                <div class="theme-input">Search workspaces...</div>
                <div class="theme-row"><b>dotfiles</b><span>idle</span></div>
                <div class="theme-row selected"><b>vellum</b><span>working</span></div>
                <div class="theme-mode">INSERT</div>
              </div>
              <h3>{theme.name}</h3>
            </article>
          ))}
        </div>
      </section>

      <section class="authoring shell">
        <div>
          <p class="kicker">Palettes are plain TOML</p>
          <h2>Describe the view.<br /><em>Keep control.</em></h2>
          <p>Choose a shell command, local file, or built-in source. Arrange source fields across multiline rows. Add conditions, dynamic colors, repeated segments, actions, and exact-match filters only where they help.</p>
          <a href={`${base}/docs/palette-authoring/`}>Author a palette →</a>
        </div>
        <pre aria-label="Example Vellum palette"><code><span class="comment"># ~/.config/vellum/palettes/agents.toml</span>
[source]
builtin = <span class="string">"herdr-agents"</span>
refresh_ms = <span class="number">750</span>

[search]
title = <span class="string">"Agents"</span>
placeholder = <span class="string">"Find an agent..."</span>

[item]
value = <span class="string">"$pane_id"</span>
template = [
  [<span class="string">"$status_icon"</span>, <span class="string">"$agent"</span>, <span class="string">"$agent_status"</span>],
  [<span class="string">"$terminal_title_stripped"</span>],
  [<span class="string">"$workspace_label"</span>, <span class="string">"$cwd"</span>],
]</code></pre>
      </section>

      <section class="closing shell">
        <p class="kicker">Vellum 0.8</p>
        <h2>Give your terminal<br />a better menu.</h2>
        <div class="install-line"><code>mise use --global github:dkarter/vellum</code></div>
        <a href={`${base}/docs/quick-start/`}>Build your first palette →</a>
      </section>
    </main>

    <footer class="shell"><a class="wordmark" href={`${base}/`} aria-label="Vellum home"><img src={logo.src} alt="" /><strong>Vellum</strong></a><span>Customizable terminal menus.</span><div><a href={docs}>Docs</a><a href="https://github.com/dkarter/vellum">GitHub</a><span>MIT</span></div></footer>

    <script>
      const root = document.documentElement;
      const themeButton = document.querySelector<HTMLButtonElement>(".theme-toggle");
      const currentTheme = () => root.dataset.theme ?? (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
      const updateThemeButton = () => {
        if (!themeButton) return;
        const isDark = currentTheme() === "dark";
        const label = `Switch to ${isDark ? "light" : "dark"} theme`;
        themeButton.ariaPressed = String(isDark);
        themeButton.ariaLabel = label;
        themeButton.title = label;
      };
      updateThemeButton();
      themeButton?.addEventListener("click", () => {
        root.dataset.theme = currentTheme() === "light" ? "dark" : "light";
        localStorage.setItem("starlight-theme", root.dataset.theme);
        updateThemeButton();
      });

      const demo = document.querySelector<HTMLElement>("[data-vellum-demo]");
      const replay = demo?.querySelector<HTMLButtonElement>("[data-demo-replay]");
      const stage = demo?.querySelector<HTMLElement>("[data-demo-stage]");
      const live = demo?.querySelector<HTMLElement>("[data-demo-live]");
      const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)");
      const labels = ["ready", "fuzzy search", "selection", "live refresh", "native actions", "complete"];
      const announcements = [
        "Vellum palette ready.",
        "Fuzzy search entered: docs.",
        "Docs website is selected.",
        "Live source refresh changed docs website from idle to working.",
        "Native action menu opened for docs website.",
        "Demo complete. Focus workspace action is ready.",
      ];
      let timers: number[] = [];

      function showStep(step: number) {
        if (!demo || !stage || !live) return;
        demo.dataset.step = String(step);
        stage.textContent = labels[step] ?? "complete";
        live.textContent = announcements[step] ?? announcements[5];
      }

      function play() {
        timers.forEach(clearTimeout);
        timers = [];
        showStep(reduceMotion.matches ? 5 : 0);
        if (reduceMotion.matches) return;
        [1, 2, 3, 4, 5].forEach((step) => timers.push(window.setTimeout(() => showStep(step), step * 1450)));
      }

      replay?.addEventListener("click", play);
      reduceMotion.addEventListener("change", play);
      if (demo) {
        const observer = new IntersectionObserver(([entry]) => {
          if (!entry?.isIntersecting) return;
          observer.disconnect();
          play();
        }, { threshold: 0.25 });
        observer.observe(demo);
      }
    </script>
  </body>
</html>
