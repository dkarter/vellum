amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Builtins.pkl"

local checks = new Mapping<String, Step> {
  ["hk-config"] {
    glob = "hk.pkl"
    output_summary = "hide"
    check = new CommandSpec { command = "hk validate"; effect = "read" }
  }

  ["rust-format"] {
    glob = List("src/**/*.rs", "tests/**/*.rs")
    output_summary = "hide"
    check = new CommandSpec { command = "cargo fmt --all -- --check"; effect = "read" }
  }

  ["rust-tests"] {
    glob = List("src/**/*.rs", "tests/**/*.rs", "Cargo.toml", "Cargo.lock")
    output_summary = "hide"
    check = new CommandSpec { command = "cargo test --locked"; effect = "write" }
  }

  ["specs"] {
    glob = List("openspec/**", "scripts/test-spec.sh", "tests/spec_links.rs")
    output_summary = "hide"
    check = new CommandSpec { command = "mise run openspec:check"; effect = "write" }
  }

  ["metadata"] {
    glob = List("palettes/**", "examples/**", "schemas/**", "taplo.toml", "mise.toml", "mise.lock", ".mise/locks/**")
    output_summary = "hide"
    check = new CommandSpec { command = "cargo test --locked --test project_metadata"; effect = "write" }
  }

  ["website"] {
    glob = "website/**"
    output_summary = "hide"
    check = new CommandSpec { command = "mise run website-build"; effect = "write" }
  }
}

hooks {
  ["check"] { steps = checks }

  ["pre-commit"] {
    fix = false
    stage = false
    stash = "none"
    steps {
      ["rust-format"] = checks["rust-format"]
      ["hk-config"] = checks["hk-config"]
      ["gitleaks"] = (Builtins.gitleaks) {
        scan = "staged"
        check = new CommandSpec {
          command = "gitleaks git --pre-commit --redact --staged --no-banner --log-level warn"
          effect = "read"
        }
      }
    }
  }

  ["commit-msg"] {
    steps {
      ["conventional-commits"] {
        check = new CommandSpec { command = "committed --commit-file {{ commit_msg_file }}"; effect = "read" }
      }
    }
  }

  ["pre-push"] { steps = checks }
}
